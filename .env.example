# Скопируйте в .env.local и заполните. Все переменные необязательные:
# без них сайт работает, но заявки не уходят на email, а аналитика не включается.

# Публичный URL сайта (для canonical, sitemap и Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.kz

# WhatsApp: номер в международном формате без "+" (77051086060)
NEXT_PUBLIC_WHATSAPP_NUMBER=77051086060

# Телефон для кнопок tel: (в формате +7...)
NEXT_PUBLIC_PHONE=+77051086060

# Email для заявок (серверная переменная, не попадает в браузер)
# Отправка через Resend: https://resend.com
RESEND_API_KEY=
LEAD_EMAIL_TO=owner@example.kz
LEAD_EMAIL_FROM=MitService <onboarding@resend.dev>

# Аналитика (клиентская). Оставьте пустым, чтобы отключить.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
